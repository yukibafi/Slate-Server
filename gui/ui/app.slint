    in-out property <string> server-players: "";
    in-out property <string> console-text: "";
    in-out property <string> cmd-text: "";
    in-out property <[Field]> tools;
    callback tools-act(string);
    callback tools-edit(string, string);
    in-out property <[ModRow]> mods;
