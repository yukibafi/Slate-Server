    in-out property <string> new-mc: "1.21.1";
    in-out property <int> new-loader: 0;
    in-out property <string> new-ram: "6";
    in-out property <string> job-text: "";
    in-out property <bool> job-busy: false;
    in-out property <string> import-text: "";
    in-out property <bool> auto-restart: false;
    in-out property <bool> engine-autostart: false;
    in-out property <string> palette: "ice";
    in-out property <string> ov-ip: "";
    in-out property <string> ov-port: "";
    in-out property <string> ov-mods: "0";
    in-out property <string> ov-backup: "none yet";
    in-out property <string> ov-mem: "-";
    in-out property <string> ov-uptime: "-";
    in-out property <string> mod-search: "";
    in-out property <string> mod-chip: "all";
    in-out property <string> mod-count-text: "";
    in-out property <string> say-text: "";
    in-out property <string> player-name: "";
    in-out property <string> ban-reason: "";
    in-out property <[PlayerRow]> online;
