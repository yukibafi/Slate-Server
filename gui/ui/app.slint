import { TextEdit, ScrollView, ListView, ComboBox } from "std-widgets.slint";

export global Theme {
    in-out property <color> bg: #0d0f12;
    in-out property <color> rail: #0a0c0f;
    in-out property <color> panel: #14171c;
    in-out property <color> panel2: #1b1f26;
    in-out property <color> line: #23272d;
    in-out property <color> line2: #343a43;
    in-out property <color> text: #eef1f5;
    in-out property <color> mute: #a3acb8;
    in-out property <color> faint: #8691a0;
    in-out property <color> accent: #7cc4ff;
    in-out property <color> on-accent: #08121b;
    in-out property <color> good: #4ade80;
    in-out property <color> warn: #fbbf24;
    in-out property <color> bad: #f87171;
}

export global ThemeCtl {
    in-out property <float> hue: 0.57;
    in-out property <float> sat: 0.51;
    in-out property <float> val: 1.0;
    in-out property <string> hex: "#7CC4FF";
    in-out property <string> surface: "tinted";
    in-out property <color> sat-a: #ffffff;
    in-out property <color> sat-b: #7cc4ff;
    in-out property <color> val-b: #7cc4ff;
    in-out property <[color]> quick;
    callback changed();
    callback committed();
    callback hex-entered(string);
    callback pick-quick(int);
    callback pick-surface(string);
}

export struct SrvCard { id: string, name: string, state: string, info: string, busy: bool, tint: color, letter: string, players: string, mem: string, uptime: string, join: string, warn1: string, warn2: string, warn1-bad: bool }
export struct ModRow { file: string, name: string, version: string, enabled: bool, update: string, badge: string, letter: string, size: string, tint: color, sel: bool }
export struct Field { key: string, label: string, help: string, kind: int, value: string, options: [string], count: int, open: bool }
export struct PlayerRow { name: string, note: string, head: image, has-head: bool }
export struct PStat { name: string, playtime: string, joins: string, last: string, first: string, online: bool, tags: string, head: image, has-head: bool }
export struct PackRow { id: string, name: string, summary: string, author: string, downloads: string, mc: string }
export struct BackupRow { name: string, size: string }
export struct HBRow { rel: string, name: string, server: string, kind: string, size: string, ago: string }
export struct BundleRow { path: string, name: string, size: string }
export struct Pal { name: string, color: color }
export struct ConLine { text: string, kind: int }
export struct ActRow { text: string, kind: int, time: string }
export struct DpRow { name: string, size: string, kind: string }
export struct BrowseRow { id: string, name: string, author: string, summary: string, downloads: string, installed: string, compat: bool, manual: bool, tint: color, letter: string }
export struct FileRow { name: string, path: string, dir: bool, size: string, mtime: string }
export struct Crumb { name: string, path: string }


component Ico inherits Image {
    width: 18px;
    height: 18px;
    colorize: Theme.mute;
    image-fit: contain;
}

component ColorBar inherits Rectangle {
    in-out property <float> value;
    in property <brush> track;
    callback moved-to(float);
    callback released();
    height: 20px;
    border-radius: 10px;
    background: root.track;
    border-width: 1px;
    border-color: Theme.line;
    Rectangle {
        x: root.value * (root.width - self.width);
        width: 18px;
        height: 18px;
        y: 0px;
        border-radius: 9px;
        background: #ffffff;
        border-width: 3px;
        border-color: #1b1e24;
    }
    bar := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { root.moved-to(max(0.0, min(1.0, (self.mouse-x - 9px) / (root.width - 18px)))); }
            if (e.kind == PointerEventKind.up) { root.released(); }
        }
        moved => { if (self.pressed) { root.moved-to(max(0.0, min(1.0, (self.mouse-x - 9px) / (root.width - 18px)))); } }
    }
}

component SurfaceBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 32px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.line;
    background: root.active ? Theme.accent.with-alpha(0.16) : (st.has-hover ? Theme.panel2 : transparent);
    Text { text: root.label; color: root.active ? Theme.accent : Theme.text; font-weight: 600; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
    st := TouchArea { clicked => { root.clicked(); } }
}

component Btn inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    height: 36px;
    border-radius: 10px;
    border-width: primary ? 0px : 1px;
    border-color: danger ? (ta.has-hover ? Theme.bad : Theme.bad.with-alpha(0.45)) : Theme.line2;
    background: !enabled ? Theme.panel : (primary ? (ta.has-hover ? Theme.accent.brighter(0.15) : Theme.accent) : (danger ? Theme.bad.with-alpha(ta.has-hover ? 0.18 : 0.10) : (ta.has-hover ? Theme.panel2 : transparent)));
    opacity: enabled ? 1.0 : 0.45;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 8px;
        alignment: center;
        if root.icon.width > 0: Image {
            source: root.icon;
            width: 16px;
            height: 16px;
            y: (parent.height - self.height) / 2;
            colorize: root.primary ? Theme.on-accent : (root.danger ? Theme.bad : Theme.text);
        }
        Text {
            text: root.label;
            color: root.primary ? Theme.on-accent : (root.danger ? Theme.bad : Theme.text);
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component ConfirmBtn inherits HorizontalLayout {
    in property <string> label;
    in property <bool> enabled: true;
    in property <length> h: 34px;
    in-out property <bool> armed: false;
    callback confirmed();
    Btn {
        label: root.armed ? "Sure? Click again" : root.label;
        danger: true;
        height: root.h;
        enabled: root.enabled;
        clicked => { if (root.armed) { root.armed = false; root.confirmed(); } else { root.armed = true; } }
    }
    Timer { interval: 3s; running: root.armed; triggered => { root.armed = false; } }
}

component IconBtn inherits Rectangle {
    in property <image> icon;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 10px;
    border-width: primary ? 0px : 1px;
    border-color: danger ? Theme.bad.with-alpha(0.45) : Theme.line2;
    background: !enabled ? Theme.panel : (primary ? (ta.has-hover ? Theme.accent.brighter(0.15) : Theme.accent) : (danger ? Theme.bad.with-alpha(ta.has-hover ? 0.18 : 0.10) : (ta.has-hover ? Theme.panel2 : transparent)));
    opacity: enabled ? 1.0 : 0.4;
    Image {
        source: root.icon;
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: primary ? Theme.on-accent : (danger ? Theme.bad : Theme.text);
    }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component TextBox inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> password: false;
    callback edited(string);
    callback accepted(string);
    height: 38px;
    border-radius: 10px;
    background: Theme.panel2;
    border-width: 1px;
    border-color: ti.has-focus ? Theme.accent : Theme.line2;
    TouchArea { clicked => { ti.focus(); } }
    HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        Rectangle {
            ti := TextInput {
                text <=> root.text;
                color: Theme.text;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                input-type: root.password ? InputType.password : InputType.text;
                selection-background-color: Theme.accent;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            Text { text: root.placeholder; color: Theme.faint; font-size: 13px; vertical-alignment: center; visible: ti.text == "" && !ti.has-focus; }
        }
    }
}

component StatePill inherits Rectangle {
    in property <string> state;
    property <color> tone: root.state == "online" ? Theme.good : (root.state == "starting" || root.state == "stopping") ? Theme.warn : (root.state == "stopped" || root.state == "panel_off") ? Theme.faint : Theme.bad;
    height: 28px;
    width: lbl.preferred-width + 39px;
    border-radius: 14px;
    background: root.tone.with-alpha(0.14);
    HorizontalLayout {
        padding-left: 11px;
        padding-right: 13px;
        spacing: 7px;
        VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: root.tone; } }
        lbl := Text {
            text: root.state == "online" ? "Online" : root.state == "starting" ? "Starting..." : root.state == "stopping" ? "Stopping..." : root.state == "stopped" ? "Offline" : root.state == "panel_off" ? "Panel off" : root.state;
            color: root.state == "stopped" || root.state == "panel_off" ? Theme.mute : root.tone;
            font-size: 12px; font-weight: 600; vertical-alignment: center;
        }
    }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled();
    width: 42px;
    height: 24px;
    border-radius: 12px;
    background: checked ? Theme.accent : Theme.panel2;
    border-width: 1px;
    border-color: checked ? Theme.accent : Theme.line2;
    animate background { duration: 120ms; }
    Rectangle {
        y: 2px;
        x: root.checked ? parent.width - self.width - 4px : 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: root.checked ? Theme.on-accent : Theme.faint;
        animate x { duration: 120ms; }
    }
    TouchArea { clicked => { root.checked = !root.checked; root.toggled(); } }
}

component Dot inherits Rectangle {
    in property <string> state;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background: state == "online" ? Theme.good : (state == "starting" || state == "stopping" || state == "connecting") ? Theme.warn : (state == "stopped") ? Theme.mute : Theme.bad;
}

component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 36px;
    border-radius: 9px;
    background: active ? Theme.panel2 : transparent;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        Text { text: root.label; color: root.active ? Theme.text : Theme.mute; font-weight: 600; vertical-alignment: center; }
    }
    TouchArea { clicked => { root.clicked(); } }
}


component Panel inherits Rectangle {
    background: Theme.panel;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.line;
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();
    height: 30px;
    border-radius: 15px;
    background: active ? Theme.accent.with-alpha(0.16) : (ta.has-hover ? Theme.panel2 : Theme.text.with-alpha(0.06));
    HorizontalLayout {
        padding-left: 13px;
        padding-right: 13px;
        Text { text: root.label; color: root.active ? Theme.accent : Theme.mute; font-weight: 600; font-size: 13px; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <string> badge: "";
    in property <int> badge-kind: 0;
    in property <bool> active: false;
    callback clicked();
    height: 42px;
    border-radius: 11px;
    background: active ? Theme.accent.with-alpha(0.14) : (ta.has-hover ? Theme.text.with-alpha(0.05) : transparent);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 12px;
        VerticalLayout { alignment: center; Image { source: root.icon; width: 18px; height: 18px; colorize: root.active ? Theme.accent : Theme.mute; } }
        Text { text: root.label; color: root.active ? Theme.accent : Theme.mute; font-weight: root.active ? 700 : 500; vertical-alignment: center; horizontal-stretch: 1; }
        if root.badge != "": VerticalLayout {
            alignment: center;
            Rectangle {
                height: 20px;
                border-radius: 10px;
                background: root.badge-kind == 2 ? Theme.bad.with-alpha(0.16) : (root.badge-kind == 1 ? Theme.warn.with-alpha(0.16) : Theme.text.with-alpha(0.08));
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text { text: root.badge; color: root.badge-kind == 2 ? Theme.bad : (root.badge-kind == 1 ? Theme.warn : Theme.mute); font-size: 12px; font-weight: 600; vertical-alignment: center; }
                }
            }
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Stat inherits VerticalLayout {
    in property <string> title;
    in property <string> value;
    spacing: 2px;
    Text { text: root.title; color: Theme.faint; font-size: 12px; font-weight: 500; }
    Text { text: root.value; color: Theme.text; font-size: 24px; font-weight: 700; }
}

component MetricTile inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <string> sub;
    in property <float> frac: -1;
    height: 112px;
    background: Theme.panel;
    border-radius: 16px;
    border-width: 1px;
    border-color: Theme.line;
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        padding-top: 14px;
        padding-bottom: 12px;
        spacing: 3px;
        Text { text: root.title; color: Theme.mute; font-size: 13px; }
        Text { text: root.value; color: Theme.text; font-size: 26px; font-weight: 700; overflow: elide; }
        if root.frac >= 0: Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.text.with-alpha(0.09);
            Rectangle { x: 0px; width: parent.width * min(root.frac, 1.0); height: 6px; border-radius: 3px; background: root.frac > 0.92 ? Theme.bad : (root.frac > 0.8 ? Theme.warn : Theme.accent); }
        }
        Text { text: root.sub; color: Theme.faint; font-size: 12px; overflow: elide; }
    }
}

component NavGroup inherits Text {
    color: Theme.faint;
    font-size: 12px;
    font-weight: 600;
}

component Pill inherits Rectangle {
    in property <string> label;
    height: 26px;
    border-radius: 13px;
    background: Theme.text.with-alpha(0.07);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text { text: root.label; color: Theme.mute; font-size: 12px; font-weight: 600; vertical-alignment: center; }
    }
}

component Check inherits Rectangle {
    in-out property <bool> checked: false;
    callback toggled();
    width: 20px;
    height: 20px;
    border-radius: 6px;
    border-width: 1px;
    border-color: checked ? Theme.accent : Theme.line;
    background: checked ? Theme.accent : Theme.rail;
    if root.checked: Image { source: @image-url("../assets/icons/check.svg"); width: 13px; height: 13px; x: 3.5px; y: 3.5px; colorize: Theme.on-accent; }
    TouchArea { clicked => { root.checked = !root.checked; root.toggled(); } }
}

component Seg inherits Rectangle {
    in property <[string]> items;
    in property <int> index: 0;
    callback picked(int);
    height: 38px;
    border-radius: 11px;
    border-width: 1px;
    border-color: Theme.line;
    background: Theme.rail;
    HorizontalLayout {
        padding: 3px;
        spacing: 2px;
        for it[i] in root.items: Rectangle {
            border-radius: 8px;
            background: i == root.index ? Theme.accent : transparent;
            Text { text: it; color: i == root.index ? Theme.on-accent : Theme.mute; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.picked(i); } }
        }
    }
}

component FieldList inherits Rectangle {
    in property <[Field]> rows;
    callback edited(string, string);
    callback toggle(string);
    callback act(string, string);
    ListView {
        for f in root.rows: Rectangle {
            height: f.kind == 9 ? 58px : (f.kind == 6 ? 58px : (f.kind == 10 ? 62px : 68px));
            if f.kind == 9: Rectangle {
                y: 6px;
                height: 44px;
                background: ta-h.has-hover ? Theme.panel2 : transparent;
                border-radius: 10px;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 10px;
                    Text { text: f.label; color: Theme.text; font-weight: 800; font-size: 16px; vertical-alignment: center; }
                    Text { text: "\{f.count} settings"; color: Theme.mute; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
                    VerticalLayout { alignment: center; Image { source: f.open ? @image-url("../assets/icons/chevron-down.svg") : @image-url("../assets/icons/chevron.svg"); width: 16px; height: 16px; colorize: Theme.mute; } }
                }
                ta-h := TouchArea { clicked => { root.toggle(f.label); } }
            }
            if f.kind == 6: HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                VerticalLayout { alignment: center; Btn { label: f.label; clicked => { root.act("btn", f.key); } } }
                Rectangle { horizontal-stretch: 1; }
            }
            if f.kind == 10: VerticalLayout {
                alignment: end;
                padding-left: 14px;
                padding-bottom: 6px;
                spacing: 1px;
                Text { text: f.label; color: Theme.accent; font-weight: 800; font-size: 15px; }
                if f.help != "": Text { text: f.help; color: Theme.mute; font-size: 12px; overflow: elide; }
            }
            if f.kind != 9 && f.kind != 6 && f.kind != 10: Rectangle {
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; opacity: 0.5; x: 14px; width: parent.width - 28px; }
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 14px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        spacing: 2px;
                        Text { text: f.label; color: Theme.text; font-weight: 700; overflow: elide; }
                        if f.help != "": Text { text: f.help; color: Theme.mute; font-size: 12px; overflow: elide; }
                    }
                    if f.kind == 7: VerticalLayout { alignment: center; Text { text: f.value; color: Theme.text; horizontal-alignment: right; overflow: elide; max-width: 380px; } }
                    if f.kind == 8: VerticalLayout { alignment: center; Btn { label: f.value; height: 30px; clicked => { root.act("btn", f.key); } } }
                    if f.kind == 0: VerticalLayout { alignment: center; TextBox { width: 240px; text: f.value; edited(t) => { root.edited(f.key, t); } } }
                    if f.kind == 1: VerticalLayout { alignment: center; Toggle { checked: f.value == "true"; toggled => { root.edited(f.key, self.checked ? "true" : "false"); } } }
                    if f.kind == 2: VerticalLayout { alignment: center; ComboBox { width: 190px; model: f.options; current-value: f.value; selected(v) => { root.edited(f.key, v); } } }
                    if f.kind == 5: HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout { alignment: center; Toggle { checked: f.value == "true"; toggled => { root.edited(f.key, self.checked ? "true" : "false"); } } }
                        VerticalLayout { alignment: center; Btn { label: "Run now"; height: 30px; clicked => { root.act("run", f.key); } } }
                        VerticalLayout { alignment: center; Btn { label: "Remove"; danger: true; height: 30px; clicked => { root.act("del", f.key); } } }
                    }
                }
            }
        }
    }
}

component Head inherits Rectangle {
    in property <image> src;
    in property <bool> has;
    in property <length> size: 24px;
    width: root.size;
    height: root.size;
    border-radius: 5px;
    background: Theme.panel2;
    clip: true;
    if root.has: Image { source: root.src; source-clip-x: 8; source-clip-y: 8; source-clip-width: 8; source-clip-height: 8; image-rendering: pixelated; width: 100%; height: 100%; }
    if root.has: Image { source: root.src; source-clip-x: 40; source-clip-y: 8; source-clip-width: 8; source-clip-height: 8; image-rendering: pixelated; width: 100%; height: 100%; }
}

component ThemePicker inherits VerticalLayout {
    spacing: 14px;
    HorizontalLayout {
        spacing: 16px;
        Rectangle {
            width: 76px;
            height: 76px;
            border-radius: 18px;
            background: Theme.accent;
            Text { text: "Aa"; color: Theme.on-accent; font-size: 26px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        }
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            alignment: center;
            Text { text: "Accent colour"; color: Theme.text; font-weight: 800; font-size: 15px; }
            Text { text: "Type any hex code, or drag the sliders. Everything updates live."; color: Theme.mute; font-size: 12px; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                TextBox { text <=> ThemeCtl.hex; placeholder: "#7CC4FF"; width: 130px; accepted(t) => { ThemeCtl.hex-entered(t); } }
                Btn { label: "Apply"; clicked => { ThemeCtl.hex-entered(ThemeCtl.hex); } }
            }
        }
    }
    HorizontalLayout { spacing: 12px; Text { text: "Hue"; color: Theme.mute; font-size: 12px; width: 70px; vertical-alignment: center; } ColorBar { value: ThemeCtl.hue; track: @linear-gradient(90deg, #ff0000 0%, #ffff00 17%, #00ff00 33%, #00ffff 50%, #0000ff 67%, #ff00ff 83%, #ff0000 100%); moved-to(v) => { ThemeCtl.hue = v; ThemeCtl.changed(); } released => { ThemeCtl.committed(); } } }
    HorizontalLayout { spacing: 12px; Text { text: "Intensity"; color: Theme.mute; font-size: 12px; width: 70px; vertical-alignment: center; } ColorBar { value: ThemeCtl.sat; track: @linear-gradient(90deg, ThemeCtl.sat-a, ThemeCtl.sat-b); moved-to(v) => { ThemeCtl.sat = v; ThemeCtl.changed(); } released => { ThemeCtl.committed(); } } }
    HorizontalLayout { spacing: 12px; Text { text: "Brightness"; color: Theme.mute; font-size: 12px; width: 70px; vertical-alignment: center; } ColorBar { value: ThemeCtl.val; track: @linear-gradient(90deg, #000000, ThemeCtl.val-b); moved-to(v) => { ThemeCtl.val = v; ThemeCtl.changed(); } released => { ThemeCtl.committed(); } } }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        VerticalLayout { alignment: center; Text { text: "Quick start"; color: Theme.mute; font-size: 12px; width: 70px; } }
        for c[i] in ThemeCtl.quick: Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 13px;
            background: c;
            border-width: 2px;
            border-color: Theme.line;
            TouchArea { clicked => { ThemeCtl.pick-quick(i); } }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout { alignment: center; Text { text: "Surfaces"; color: Theme.mute; font-size: 12px; width: 70px; } }
        SurfaceBtn { label: "Graphite"; active: ThemeCtl.surface == "graphite"; clicked => { ThemeCtl.pick-surface("graphite"); } }
        SurfaceBtn { label: "Tinted"; active: ThemeCtl.surface == "tinted"; clicked => { ThemeCtl.pick-surface("tinted"); } }
        SurfaceBtn { label: "Black"; active: ThemeCtl.surface == "black"; clicked => { ThemeCtl.pick-surface("black"); } }
    }
}

component HubRail inherits Rectangle {
    in property <string> active;
    in property <string> ver-text;
    in property <string> where-ip;
    in property <string> where-alt;
    in property <string> where-text;
    in property <int> hub-total;
    callback goto(string);
    callback copy(string);
    width: 232px;
    background: Theme.rail;
    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
    VerticalLayout {
        padding: 22px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 4px;
        HorizontalLayout {
            padding-left: 8px;
            spacing: 11px;
            height: 40px;
            VerticalLayout { alignment: center; Image { source: @image-url("../assets/icon-1024.png"); width: 34px; height: 34px; } }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text { text: "Create Panel"; color: Theme.text; font-size: 15px; font-weight: 700; }
                Text { text: root.ver-text; color: Theme.faint; font-size: 11px; overflow: elide; }
            }
        }
        Rectangle { height: 18px; }
        NavItem { label: "Servers"; badge: "\{root.hub-total}"; icon: @image-url("../assets/icons/server.svg"); active: root.active == "hub"; clicked => { root.goto("hub"); } }
        NavItem { label: "Backups"; icon: @image-url("../assets/icons/archive.svg"); active: root.active == "hbackups"; clicked => { root.goto("hbackups"); } }
        NavItem { label: "Discord bot"; icon: @image-url("../assets/icons/bolt.svg"); active: root.active == "discord"; clicked => { root.goto("discord"); } }
        NavItem { label: "Settings"; icon: @image-url("../assets/icons/sliders.svg"); active: root.active == "settings"; clicked => { root.goto("settings"); } }
        Rectangle { vertical-stretch: 1; }
        if root.where-ip != "": Rectangle {
            height: 124px;
            background: Theme.panel;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 14px;
                spacing: 6px;
                HorizontalLayout { spacing: 8px; VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.good; } } Text { text: "This computer is the host"; color: Theme.text; font-weight: 600; font-size: 13px; overflow: elide; } }
                Text { text: "Connect your Windows PC with"; color: Theme.faint; font-size: 12px; }
                Rectangle {
                    height: 32px;
                    border-radius: 9px;
                    background: Theme.panel2;
                    border-width: 1px;
                    border-color: Theme.line;
                    Text { x: 10px; width: parent.width - 50px; text: root.where-ip; color: Theme.text; font-size: 12px; vertical-alignment: center; overflow: elide; }
                    Image { x: parent.width - 28px; y: 8px; width: 16px; height: 16px; source: @image-url("../assets/icons/copy.svg"); colorize: Theme.mute; }
                    TouchArea { clicked => { root.copy(root.where-ip); } }
                }
                if root.where-alt != "": Text { text: "or " + root.where-alt; color: Theme.faint; font-size: 11px; overflow: elide; }
            }
        }
        if root.where-ip == "": Rectangle {
            height: 86px;
            background: Theme.panel;
            border-radius: 14px;
            border-width: 1px;
            border-color: Theme.line;
            VerticalLayout {
                padding: 14px;
                spacing: 6px;
                HorizontalLayout { spacing: 8px; VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.good; } } Text { text: "Connected"; color: Theme.text; font-weight: 600; font-size: 13px; } }
                Text { text: root.where-text; color: Theme.faint; font-size: 11px; wrap: word-wrap; overflow: elide; }
            }
        }
    }
}

export component App inherits Window {
    title: "Create Panel";
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 1000px;
    min-height: 600px;
    background: Theme.bg;
    default-font-size: 13px;

    in-out property <string> server-letter: "C";
