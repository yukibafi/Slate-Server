    callback quit-engine();
    function go-hub-page(k: string) {
        root.note = "";
        if (k == "hbackups") { root.hb-msg = ""; root.page = "hbackups"; root.hb-refresh(); }
        else if (k == "discord") { root.dc-msg = ""; root.page = "discord"; root.dc-refresh(); root.al-load(-1); }
        else if (k == "settings") { root.page = "settings"; root.lid-refresh(); }
        else { root.page = "hub"; }
    }
    in-out property <string> page: "connect";       // connect | hub | server | new | import
    in-out property <string> tab: "overview";
    in-out property <string> status: "";
    in-out property <string> remote-host: "";
    in-out property <string> remote-key: "";
    in-out property <bool> connected: false;
