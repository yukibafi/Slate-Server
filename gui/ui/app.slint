    in-out property <bool> settings-dirty: false;
    in-out property <string> settings-search: "";
    in-out property <[Pal]> pals;
    in-out property <[Pal]> pals2;
    // ---- v3 additions
    in-out property <string> ov-public: "Looking up...";
