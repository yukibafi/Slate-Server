    in-out property <string> act-filter: "all";
    in-out property <string> say2-text: "";
    in-out property <[ConLine]> con;
    in-out property <string> con-search: "";
    in-out property <string> con-filter: "all";
    in-out property <bool> con-auto: true;
    in-out property <string> con-count: "0 lines";
    in-out property <string> mods-tab: "mods";
    in-out property <string> mods-view: "installed";
    in-out property <string> mod-sort: "Name";
    in-out property <bool> more-open: false;
    in-out property <int> sel-count: 0;
    in-out property <int> c-all: 0;
    in-out property <int> c-dis: 0;
    in-out property <int> c-cli: 0;
    in-out property <int> c-upd: 0;
    in-out property <string> mods-sub: "";
    in-out property <string> mods-msg: "";
    in-out property <string> br-q: "";
